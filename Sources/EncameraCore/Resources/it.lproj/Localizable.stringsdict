	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@album_count@</string>
		<key>album_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Chiave per %d album</string>
			<key>many</key>
			<string>Chiave per %d di album</string>
			<key>other</key>
			<string>Chiave per %d album</string>
		</dict>
	</dict>
	<key>KeyPhrasePicker.ItemCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d elemento</string>
			<key>many</key>
			<string>%d di elementi</string>
			<key>other</key>
			<string>%d elementi</string>
		</dict>
	</dict>
</dict>
</plist>
