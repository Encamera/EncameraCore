		</dict>
	</dict>
	<key>EncameraDrawerFactory.FirstImportExplainerDrawer.FilesBody</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
