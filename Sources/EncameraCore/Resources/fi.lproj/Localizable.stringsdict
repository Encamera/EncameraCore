<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ Item(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>kohdetta</string>
			<key>one</key>
			<string>kohde</string>
			<key>other</key>
			<string>kohdetta</string>
		</dict>
	</dict>
	<key>AlbumDetailView.FileCountOnLocation</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@file_count@ sijainnissa %2$@</string>
		<key>file_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d tiedostoa</string>
			<key>one</key>
			<string>%d tiedosto</string>
			<key>other</key>
			<string>%d tiedostoa</string>
		</dict>
	</dict>
	<key>CloudKitMigration.PartialMoveBannerMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@moved@ %2$@, %3$#@remaining@</string>
		<key>moved</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d kohde siirrettiin sijaintiin</string>
			<key>other</key>
			<string>%1$d kohdetta siirrettiin sijaintiin</string>
		</dict>
		<key>remaining</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%3$d on yhä täällä</string>
			<key>other</key>
			<string>%3$d on yhä täällä</string>
		</dict>
	</dict>
	<key>CloudKitUpgrade.IntroIncludes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Tämä päivitys sisältää %#@album_count@</string>
		<key>album_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d iCloud-albumia</string>
			<key>one</key>
			<string>%d iCloud-albumin</string>
			<key>other</key>
			<string>%d iCloud-albumia</string>
		</dict>
	</dict>
	<key>CloudKitUpgrade.AlbumItemCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
