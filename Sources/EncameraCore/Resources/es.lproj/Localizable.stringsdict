<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ Item(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>elementos</string>
			<key>one</key>
			<string>elemento</string>
			<key>many</key>
			<string>elementos</string>
			<key>other</key>
			<string>elementos</string>
		</dict>
	</dict>
	<key>AlbumDetailView.FileCountOnLocation</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@file_count@ en %2$@</string>
		<key>file_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d archivos</string>
			<key>one</key>
			<string>%d archivo</string>
			<key>many</key>
			<string>%d archivos</string>
			<key>other</key>
			<string>%d archivos</string>
		</dict>
	</dict>
	<key>CloudKitMigration.PartialMoveBannerMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@moved@ %2$@, %3$#@remaining@</string>
		<key>moved</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d elemento se movió a</string>
			<key>many</key>
			<string>%1$d elementos se movieron a</string>
			<key>other</key>
			<string>%1$d elementos se movieron a</string>
		</dict>
		<key>remaining</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%3$d sigue aquí</string>
			<key>many</key>
			<string>%3$d siguen aquí</string>
			<key>other</key>
			<string>%3$d siguen aquí</string>
		</dict>
	</dict>
	<key>CloudKitUpgrade.IntroIncludes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Esta actualización incluye %#@album_count@</string>
		<key>album_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d álbumes de iCloud</string>
			<key>one</key>
			<string>%d álbum de iCloud</string>
			<key>many</key>
			<string>%d álbumes de iCloud</string>
			<key>other</key>
			<string>%d álbumes de iCloud</string>
		</dict>
	</dict>
	<key>CloudKitUpgrade.AlbumItemCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d elementos</string>
			<key>one</key>
			<string>%d elemento</string>
			<key>many</key>
			<string>%d elementos</string>
			<key>other</key>
			<string>%d elementos</string>
		</dict>
	</dict>
	<key>AlbumGridItem.ItemCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d elementos</string>
			<key>one</key>
			<string>%d elemento</string>
			<key>many</key>
			<string>%d elementos</string>
			<key>other</key>
			<string>%d elementos</string>
		</dict>
	</dict>
	<key>KeyPhrasePicker.KeyForAlbums</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@album_count@</string>
		<key>album_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Clave para %d álbum</string>
			<key>many</key>
			<string>Clave para %d álbumes</string>
			<key>other</key>
			<string>Clave para %d álbumes</string>
		</dict>
	</dict>
	<key>KeyPhrasePicker.ItemCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d elemento</string>
			<key>many</key>
			<string>%d elementos</string>
			<key>other</key>
			<string>%d elementos</string>
		</dict>
	</dict>
</dict>
</plist>
