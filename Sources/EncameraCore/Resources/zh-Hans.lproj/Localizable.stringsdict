<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ Item(s)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>项</string>
			<key>other</key>
			<string>项</string>
		</dict>
	</dict>
	<key>AlbumDetailView.FileCountOnLocation</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@file_count@（位于%2$@）</string>
		<key>file_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d 个文件</string>
			<key>other</key>
			<string>%d 个文件</string>
		</dict>
	</dict>
	<key>CloudKitMigration.PartialMoveBannerMessage</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@moved@%2$@，%3$#@remaining@</string>
		<key>moved</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%1$d 个项目已移至</string>
		</dict>
		<key>remaining</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%3$d 个仍在此处</string>
		</dict>
	</dict>
	<key>CloudKitUpgrade.IntroIncludes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>此次升级包含%#@album_count@</string>
		<key>album_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string> %d 个 iCloud 相簿</string>
			<key>other</key>
			<string> %d 个 iCloud 相簿</string>
		</dict>
	</dict>
	<key>CloudKitUpgrade.AlbumItemCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d 个项目</string>
			<key>other</key>
			<string>%d 个项目</string>
		</dict>
	</dict>
	<key>AlbumGridItem.ItemCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d 个项目</string>
			<key>other</key>
			<string>%d 个项目</string>
		</dict>
	</dict>
	<key>KeyPhrasePicker.KeyForAlbums</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@album_count@</string>
		<key>album_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 个相簿的密钥</string>
		</dict>
	</dict>
	<key>KeyPhrasePicker.ItemCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 个项目</string>
		</dict>
	</dict>
	<key>EncameraDrawerFactory.FirstImportExplainerDrawer.Title</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>这些项目现已加密</string>
		</dict>
	</dict>
	<key>EncameraDrawerFactory.FirstImportExplainerDrawer.PhotosBody</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>您可以放心地从相机胶卷中删除原件。</string>
		</dict>
	</dict>
	<key>EncameraDrawerFactory.FirstImportExplainerDrawer.FilesBody</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@item_count@</string>
		<key>item_count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>您可以放心地从“文件”中删除原件。</string>
		</dict>
	</dict>
</dict>
</plist>
